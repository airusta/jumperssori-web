# SEO: un solo host canónico — https://jumperssori.com (sin www).
# Google estaba indexando 4 variantes (http/https × www/apex) como páginas duplicadas.
# Las reglas solo actúan sobre el dominio de producción: staging.jumperssori.com no se toca.
RewriteEngine On

# www → apex (301)
RewriteCond %{HTTP_HOST} ^www\.jumperssori\.com$ [NC]
RewriteRule ^ https://jumperssori.com%{REQUEST_URI} [R=301,L]

# http → https (301) — respeta X-Forwarded-Proto por si el DNS pasa por el proxy de Cloudflare
RewriteCond %{HTTP_HOST} ^jumperssori\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://jumperssori.com%{REQUEST_URI} [R=301,L]

# Texto siempre en UTF-8 (los acentos del title/description en los resultados de búsqueda)
AddDefaultCharset UTF-8

# Cache de estáticos: mejora Core Web Vitals sin arriesgar HTML viejo
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
